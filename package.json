{
  "name": "arrayify-stream",
  "version": "3.0.0",
  "description": "Converts a Node readable stream into an array",
  "author": "Ruben Taelman <rubensworks@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/rubensworks/arrayify-stream.js#readme",
  "repository": "git@github.com:rubensworks/arrayify-stream.js.git",
  "bugs": {
    "url": "https://github.com/rubensworks/arrayify-stream.js/issues"
  },
  "keywords": [
    "stream",
    "array",
    "readable stream"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    }
  },
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "typings": "index",
  "files": [
    "esm/index.d.ts",
    "esm/index.js",
    "esm/index.js.map",
    "index.d.ts",
    "index.js",
    "index.js.map"
  ],
  "pre-commit": [
    "build",
    "test"
  ],
  "scripts": {
    "test": "jest ${1}",
    "test-watch": "jest ${1} --watch",
    "coveralls": "jest --coverage && cat ./coverage/lcov.info | coveralls",
    "validate": "npm ls",
    "lint": "eslint . --cache",
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc",
    "build:esm": "tsc -d --module es2015 --moduleResolution nodenext --outDir esm",
    "prepare": "npm run build",
    "version": "manual-git-changelog onversion"
  },
  "devDependencies": {
    "@rubensworks/eslint-config": "^3.1.0",
    "@types/jest": "^29.0.0",
    "asynciterator": "^3.2.1",
    "coveralls": "^3.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.0.0",
    "manual-git-changelog": "^1.0.0",
    "pre-commit": "^2.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "globals": {
      "ts-jest": {
        "tsconfig": "test/tsconfig.json"
      }
    },
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx)$"
    ],
    "testRegex": "(/test/.*|(\\.|/)(test|spec))\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "collectCoverage": true,
    "testEnvironment": "node"
  }
}
